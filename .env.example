# Database driver: use "sqlite" now or "postgres" after provisioning PostgreSQL.
# Restart the application after changing this value.
DB_DRIVER="sqlite"
SQLITE_DATABASE_URL="file:./data/hopefoundation.db"
# For Vercel, use a hosted libSQL/Turso database instead:
# SQLITE_DATABASE_URL="libsql://your-database.turso.io"
# SQLITE_AUTH_TOKEN="your-database-token"

# PostgreSQL is only used when DB_DRIVER="postgres".
# Quick local setup:
#   docker run -d --name hopefoundation-db \
#     -e POSTGRES_PASSWORD=hopefoundation -e POSTGRES_DB=hopefoundation \
#     -p 5433:5432 --restart unless-stopped postgres:16-alpine
DATABASE_URL="postgres://user:password@localhost:5432/hopefoundation"

# Initial protected administrator, created by `pnpm db:seed`
DEFAULT_ADMIN_NAME="Default Administrator"
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="replace-with-a-strong-password"

# Authenticated dashboard media uploads
MEDIA_UPLOAD_ENABLED=false
BUNNY_STORAGE_ZONE="your-zone-name"
BUNNY_STORAGE_PASSWORD="your-storage-zone-password"
BUNNY_STORAGE_HOSTNAME="storage.bunnycdn.com"
BUNNY_CDN_URL="https://your-pull-zone.b-cdn.net"
