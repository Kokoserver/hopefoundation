# Postgres connection string for Drizzle ORM
# Copy this file to .env.local and fill in your actual database credentials
#
# Quick local setup with Docker (then run `pnpm db:push && pnpm db:seed`):
#   docker run -d --name hopefoundation-db \
#     -e POSTGRES_PASSWORD=hopefoundation -e POSTGRES_DB=hopefoundation \
#     -p 5433:5432 --restart unless-stopped postgres:16-alpine
#   DATABASE_URL="postgres://postgres:hopefoundation@localhost:5433/hopefoundation"
DATABASE_URL="postgres://user:password@localhost:5432/hopefoundation"

# Bunny.net image storage — deferred to a future pass
# BUNNY_STORAGE_ZONE="your-zone-name"
# BUNNY_STORAGE_API_KEY="your-api-key"
# BUNNY_PULL_ZONE_URL="https://your-pull-zone.b-cdn.net"
